# ============================================================
# King of Barbecue — environment variables
# Copy to `.env` (root, loaded via docker-compose `env_file`)
# or pass through your process manager. NEVER commit real secrets.
# ============================================================

# ---- PostgreSQL ----
DATABASE_URL=postgres://kob:kob@localhost:5432/kob
# Used only by tests (must be a separate database):
TEST_DATABASE_URL=postgres://kob:kob@localhost:5432/kob_test

# ---- Redis (carts, BullMQ, pub/sub) ----
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma separated origins allowed to call the API from a browser (CORS).
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
# Used to sign guest order-tracking tokens (SSE authorization).
TRACKING_SECRET=change-me-please-use-another-long-random-string
JWT_COOKIE_NAME=kob_session

# ---- Web (Next.js) ----
# URL the Next.js server uses to reach the API (server components + rewrites).
# Local dev: http://localhost:4000  |  Docker Compose: http://api:4000
# Internal only — it is never exposed to the browser.
API_INTERNAL_URL=http://localhost:4000
# Optional: if set, client-side fetches/SSE bypass Next rewrites and call this
# absolute origin (must allow CORS). Leave empty to use same-origin `/api`.
NEXT_PUBLIC_API_URL=

# ---- Email (optional; falls back to console transport in dev) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="King of Barbecue <orders@kingofbarbecue.local>"

# ---- Webhooks (future payment providers) ----
PAYMENT_WEBHOOK_SECRET=change-me-another-secret

# ---- Seed (development only) ----
SEED_STAFF_EMAIL=manager@kingofbarbecue.local
SEED_STAFF_PASSWORD=Manager123!
SEED_CUSTOMER_EMAIL=anna@example.com
SEED_CUSTOMER_PASSWORD=Customer123!
